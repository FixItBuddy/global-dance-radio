{
  "name": "gta-vi-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Spoiler-aware GTA VI companion: continuously ingests tips, secrets, collectibles and trending guides.",
  "engines": { "node": ">=22" },
  "scripts": {
    "ingest": "node pipeline/ingest.mjs",
    "test": "node --test test/*.test.mjs",
    "e2e": "node test/e2e.cjs",
    "serve": "node -e \"require('http').createServer((q,s)=>require('fs').createReadStream('.'+(q.url.split('?')[0]==='/'?'/index.html':q.url.split('?')[0])).on('error',()=>{s.statusCode=404;s.end()}).pipe(s)).listen(8080,()=>console.log('http://localhost:8080'))\""
  }
}
